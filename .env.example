# ──────────────────────────────────────────────────────────
# BTS College Bus Tracking System — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env (or .env.local) and fill in the values.
#   cp .env.example .env
#
# NEVER commit actual secrets or credentials to version control.
# ──────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────
# PostgreSQL connection string used by Prisma and the backend API.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/bts_db?schema=public

# ── Authentication ───────────────────────────────────────
# High-entropy secret used to sign and verify JSON Web Tokens (min 32 characters).
# Generate with: openssl rand -base64 64
JWT_SECRET=<REPLACE_WITH_A_HIGH_ENTROPY_SECRET>

# ── Server & Runtime Environment ─────────────────────────
# Runtime mode: development | production | test
NODE_ENV=development

# HTTP port for the NestJS API service (default: 3001)
PORT=3001

# ── Security & CORS Whitelist ────────────────────────────
# Allowed origin(s) for browser CORS requests.
# Supports single origin or comma-separated origins in production.
# Examples:
#   Development: http://localhost:3000
#   Production:  https://bts.college.edu,https://admin.bts.college.edu
CORS_ORIGIN=http://localhost:3000

# ── Frontend Client Endpoints ────────────────────────────
# Base HTTP URL the Next.js frontend uses to call the backend REST API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket gateway endpoint used for real-time tracking streams.
NEXT_PUBLIC_WS_URL=http://localhost:3001
