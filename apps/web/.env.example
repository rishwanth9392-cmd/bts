# ──────────────────────────────────────────────────────────
# BTS Web Client — Environment Variables
# ──────────────────────────────────────────────────────────
# Base HTTP URL for client API requests
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket gateway endpoint for real-time tracking
NEXT_PUBLIC_WS_URL=http://localhost:3001

# High-entropy secret for Edge middleware JWT validation (must match backend JWT_SECRET)
JWT_SECRET=<REPLACE_WITH_A_HIGH_ENTROPY_SECRET>

# Runtime mode: development | production | test
NODE_ENV=development
